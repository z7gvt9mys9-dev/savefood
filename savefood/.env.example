# Keep empty for the normal Vite/nginx same-origin proxy. Setting localhost
# makes phones and other remote clients call themselves instead of SaveFood.
VITE_API_URL=
VITE_YANDEX_MAPS_API_KEY=your_yandex_maps_api_key_here
# Ключ Geosuggest API (отдельный от ключа JS API/Геокодера) — для подсказок адресов при вводе
VITE_YANDEX_SUGGEST_API_KEY=your_yandex_suggest_api_key_here
